{
  "name": "dash-starter",
  "version": "0.1.0",
  "description": "Replacement contract of the create-dash-starter installer. Every literal of `tokens` is replaced by the value of the collected identity, and the files of `removePaths`, `removeSections` and `removeLines` are taken out of the generated project. The files of `preserve` keep their text untouched, and `core` and `userOwned` tell a core update which files it may replace.",
  "identity": {
    "name": {
      "description": "Product name shown in the UI, emails and page titles.",
      "default": "Dash"
    },
    "slug": {
      "description": "Kebab-case slug used for the project directory, package scope and Docker Compose project.",
      "default": "dash-starter"
    },
    "description": {
      "description": "One-line description used in the README and the landing page metadata.",
      "default": "The AI SaaS starter for launching your next product"
    },
    "locale": {
      "description": "Default locale of the generated project.",
      "default": "en",
      "options": ["en", "es"]
    },
    "palette": {
      "description": "Color palette every visitor of the generated project sees.",
      "default": "line",
      "options": ["line", "ink", "ocean", "forest", "plum", "ember"]
    },
    "email": {
      "description": "Support contact shown in the footer and in every transactional email.",
      "default": "support@{slug}.test"
    }
  },
  "tokens": {
    "The AI SaaS starter for launching your next product": "description",
    "support@dash-starter.test": "email",
    "dash-test-storage": "storageTest",
    "dash-storage": "storage",
    "dash_consent": "consent",
    "dash_test": "codeTest",
    "dash-starter": "slug",
    "dash starter": "name",
    "dash_": "prefix",
    "@dash/": "scope",
    ".dash": "metadata",
    "Dash": "name",
    "dash": "slug"
  },
  "files": ["**/*"],
  "exclude": [
    "node_modules/**",
    "**/node_modules/**",
    ".git/**",
    "**/dist/**",
    "**/build/**",
    "**/.adonisjs/**",
    "**/.vitest/**",
    ".claude/settings.local.json",
    ".claude/worktrees/**",
    ".claude/.headroom*",
    ".claude/dsh-allow",
    ".serena/**",
    ".opencode/**",
    "**/.DS_Store",
    "**/*.log",
    "package-lock.json",
    "**/package-lock.json",
    "openspec/changes/**",
    "packages/create-app/**"
  ],
  "removePaths": ["packages/create-app", "openspec/changes"],
  "removeSections": [{ "file": "README.md", "heading": "## The installer" }],
  "removeLines": [{ "file": "README.md", "text": "packages/create-app" }],
  "removeWorkflowJobs": ["installer"],
  "preserve": ["packages/core-tools/**"],
  "core": [
    "apps/api/app/**",
    "apps/api/start/**",
    "apps/api/config/**",
    "apps/api/database/**",
    "apps/api/resources/**",
    "apps/api/tests/unit/**",
    "apps/api/tests/functional/**",
    "apps/web/src/**",
    "apps/web/vite.config.ts",
    "apps/web/tsconfig*.json",
    "apps/web/index.html",
    "packages/ui/**",
    "packages/core-tools/**"
  ],
  "userOwned": [
    "apps/api/app/features/**",
    "apps/api/tests/functional/features/**",
    "apps/web/src/features/**",
    "packages/ui/src/custom/**",
    ".env*",
    "**/.env*",
    "openspec/**",
    "docs/**",
    "README.md",
    "package.json",
    "apps/api/package.json",
    "apps/web/package.json",
    "package-lock.json",
    "**/package-lock.json",
    "**/Dockerfile*",
    "docker-compose*.yml",
    ".github/**"
  ]
}
