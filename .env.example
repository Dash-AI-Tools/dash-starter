# Root environment for Docker Compose. Copy to `.env` and fill in the values.
#
# The API reads its own variables from `apps/api/.env` when it runs on the
# host. Inside Compose the `docker-compose.yml` service definitions provide
# them, so only the shared secrets belong here.

# Generate with: node ace generate:key --force --name=APP_KEY (in apps/api)
APP_KEY=

# Public URL of the web app, used to build absolute links in emails.
APP_URL=http://localhost:5173

# Support email shown in the footer and in transactional emails.
SUPPORT_EMAIL=support@dash-starter.test

# Demo mode shows the palette picker on the public site and the dashboard, so
# visitors can try every colour palette. The template runs with it on to show
# the palettes; the installer turns it off in every new project.
DEMO_MODE=true
