{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "paths": { "@/*": ["./src/*"] },

    /* The API sources are type-checked as part of this program, so the
       strictness must match the API tsconfig or shared types resolve
       differently (e.g. middleware args become required). */
    "strict": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* The API registry is generated with decorators, so they must be enabled
       here too for the shared types to resolve. */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src",
    "../api/.adonisjs/client/**/*.ts",
    "../api/.adonisjs/server/routes.d.ts",
    "../api/app/**/*.ts",
    "../api/start/**/*.ts"
  ]
}
