# Environment used by the API container in `docker-compose.yml`.
#
# It mirrors `apps/api/.env.example`, but points at the Compose services
# instead of the host. `APP_KEY` is injected by Compose from the root `.env`.
TZ=UTC
PORT=3333
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
APP_KEY=
APP_URL=http://localhost:3333
WEB_URL=http://localhost:5173
DEFAULT_LOCALE=en

SESSION_DRIVER=database

DB_HOST=db
DB_PORT=5432
DB_USER=dash
DB_PASSWORD=dash
DB_DATABASE=dash

MAIL_TRANSPORT=smtp
MAIL_FROM=Dash <no-reply@dash-starter.test>
MAIL_FROM_NAME=Dash
BREVO_API_KEY=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_ENV=test

AI_PROVIDER=stub
AI_TIMEOUT_MS=60000
AI_CHAT_PROVIDER=
AI_CHAT_MODEL=
AI_FAST_PROVIDER=
AI_FAST_MODEL=
AI_REASONING_PROVIDER=
AI_REASONING_MODEL=
AI_IMAGE_PROVIDER=
AI_IMAGE_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
QWEN_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=

DRIVE_DISK=local
DRIVE_ROOT=/tmp/dash-storage
S3_KEY=
S3_SECRET=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=

LIMITER_STORE=database
