}}}
import type {{ modelName }} from '{{ modelImportPath }}'
import { BaseTransformer } from '@adonisjs/core/transformers'

/**
 * A {{ one }}, as the API answers it. Every field is picked by name, so a new
 * column never reaches the client by accident.
 */
export default class {{ transformerName }} extends BaseTransformer<{{ modelName }}> {
  toObject() {
    return this.pick(this.resource, ['id'])
  }
}

{{{ "\n\n" + exports({ finalNewline: true }) }}}
