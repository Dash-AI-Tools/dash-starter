import type { HttpContext } from '@adonisjs/core/http'

/**
 * The HTTP layer of the {{ many }}.
 *
 * One request is one method: it validates the payload with
 * \`request.validateUsing(...)\`, authorizes the caller with
 * \`bouncer.authorize(...)\`, delegates to a service of \`#services/\` and answers
 * with \`serialize.withoutWrapping(...)\` and a transformer of \`#transformers/\`.
 * No database query lives here.
 */
export default class {{ controllerName }} {
{{#each actions as action, index}}
{{{ index ? "\n\n" : "\n" }}}  /**
   * Answers the {{ string(action).noCase().toString() }} request.
   */
  async {{ action }}({ serialize }: HttpContext) {
    return serialize.withoutWrapping({})
  }
{{/each}}
}

{{{ "\n\n" + exports({ finalNewline: true }) }}}
