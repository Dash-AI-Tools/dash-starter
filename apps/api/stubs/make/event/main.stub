import { BaseEvent } from '@adonisjs/core/events'

/**
 * The \`{{ eventName }}\` event.
 *
 * It carries the data its listeners need, passed to the constructor, so a
 * listener never queries it again.
 */
export default class {{ eventName }} extends BaseEvent {}

{{{ "\n\n" + exports({ finalNewline: true }) }}}
