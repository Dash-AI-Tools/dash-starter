import vine from '@vinejs/vine'

/**
 * The payload of the creation of a {{ one }}.
 */
export const {{ createAction }} = vine.create({})

/**
 * The payload of the update of a {{ one }}. Every field is optional, so the
 * form can send only what changed.
 */
export const {{ updateAction }} = vine.create({})

