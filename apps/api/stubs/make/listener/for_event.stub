import type {{ eventName }} from '{{ eventImportPath }}'
import logger from '@adonisjs/core/services/logger'

/**
 * The \`{{ listenerName }}\` listener of \`{{ eventName }}\`.
 *
 * It delegates the work to a service of \`#services/\`, so it stays as thin as a
 * controller and the work can be tested without an event.
 */
export default class {{ listenerName }} {
  async handle(event: {{ eventName }}) {
    logger.debug({ event: event.constructor.name }, 'handled by {{ listenerName }}')
  }
}

{{{ "\n\n" + exports({ finalNewline: true }) }}}
