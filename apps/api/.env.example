# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
# Generate with: node ace generate:key
APP_KEY=
APP_URL=http://${HOST}:${PORT}
WEB_URL=http://localhost:5173
DEFAULT_LOCALE=en

# Session
SESSION_DRIVER=database

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5433
DB_USER=dash
DB_PASSWORD=dash
DB_DATABASE=dash

# Mail. "smtp" targets the local Mailpit catcher, "brevo" uses the
# transactional API and "fake" captures messages in memory (tests).
MAIL_TRANSPORT=smtp
MAIL_FROM=Dash <no-reply@dash-starter.test>
MAIL_FROM_NAME=Dash
BREVO_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Creem payments. Use "test" outside production.
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_ENV=test

# AI provider. "stub" returns deterministic answers and is the default
# outside production.
AI_PROVIDER=stub
AI_TIMEOUT_MS=60000
# Each alias points at a provider and at a model of that provider. The
# provider of an alias can be another one, so the chat can run on one vendor
# and the images on another.
AI_CHAT_PROVIDER=
AI_CHAT_MODEL=
AI_FAST_PROVIDER=
AI_FAST_MODEL=
AI_REASONING_PROVIDER=
AI_REASONING_MODEL=
AI_IMAGE_PROVIDER=
AI_IMAGE_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# The Chinese providers and the local ones talk the OpenAI dialect.
QWEN_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
# Any other OpenAI-compatible endpoint.
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=

# File storage
DRIVE_DISK=local
DRIVE_ROOT=/tmp/dash-storage
S3_KEY=
S3_SECRET=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=

# Rate limiting
LIMITER_STORE=database